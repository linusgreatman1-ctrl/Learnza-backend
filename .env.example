DATABASE_URL="postgresql://user:password@localhost:5432/learnza"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4100

# AI Teacher (interactive LLM lessons) -- pick one, Gemini is used first if both are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# AI Teacher video avatar (api.simli.ai) -- both required together.
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Subscription billing -- at least one of these two is required for checkout to work.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
