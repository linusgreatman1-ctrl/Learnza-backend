DATABASE_URL="postgresql://user:password@localhost:5432/learnza"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4100

# AI Teacher (interactive LLM lessons) -- pick one, Gemini is used first if both are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# AI Teacher video avatar (api.simli.ai) -- both required together.
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Payments are Flutterwave only. The PUBLIC key opens the checkout popup in the browser (safe to
# expose); the SECRET key and webhook hash stay on the server and are what confirm a payment.
# Without the public key, only bank transfer / USSD (confirmed by an admin) is offered.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Bank transfer / USSD details shown at checkout (defaults to PassNow's account).
PAY_BANK_NAME=
PAY_ACCOUNT_NAME=
PAY_ACCOUNT_NUMBER=

# Set to "true" once ready to actually enforce subscriptions (AI Teacher, recorded
# lectures, live classes, research assistant). Left unset/false during testing so
# everything is free.
REQUIRE_SUBSCRIPTION=

# e-Library file uploads -- without this, uploaded files go to local disk, which does
# NOT survive a redeploy. All three required together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The platform owner's login for /admin. Created on first boot if no super admin exists
# (idempotent); change the password from the panel afterwards.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=

# Access-token lifetime (refresh tokens last 30 days). Default 15m.
ACCESS_TOKEN_TTL=15m

# Email (password reset, announcements, bulk messages).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS (Termii) for announcements and bulk messages.
TERMII_API_KEY=
TERMII_SENDER_ID=
