generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support; Role is one of STUDENT | LECTURER | ADMIN, enforced in app code.

model School {
  id               String        @id @default(cuid())
  name             String
  location         String?       // branch/campus, e.g. "Igueben", "Afuze", "Abudu"
  createdAt        DateTime      @default(now())
  licenseStatus    String        @default("ACTIVE") // ACTIVE | EXPIRED
  licenseExpiresAt DateTime?
  departments      Department[]
  users            User[]
  applications     Application[]
  semesters        Semester[]
  hostels          Hostel[]
  attitudeTests    AttitudeTest[]
}

// A school's own term/semester calendar. isCurrent marks the one new activity
// (courses, assessments, assignments, attendance, results) gets stamped with.
model Semester {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id])
  schoolId  String
  name      String   // e.g. "First Semester 2025/2026"
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  courses     Course[]
  assessments Assessment[]
  assignments Assignment[]
  attendance  ClassAttendanceRecord[]
  results     Result[]
}

// A named hostel building, e.g. "Daws Hostel", "Mammy Hostel" -- lets admin
// group hostel allocations by hostel rather than one flat student list.
model Hostel {
  id           String              @id @default(cuid())
  school       School              @relation(fields: [schoolId], references: [id])
  schoolId     String
  name         String
  applications HostelApplication[]
}

// A school-owned bank of admission attitude-test questions, taken by an
// applicant during admissions (kept separate from Assessment since that
// model requires a courseId, which an applicant doesn't have yet).
model AttitudeTest {
  id        String                 @id @default(cuid())
  school    School                 @relation(fields: [schoolId], references: [id])
  schoolId  String
  title     String
  createdAt DateTime               @default(now())
  questions AttitudeTestQuestion[]
  submissions AttitudeTestSubmission[]
}

model AttitudeTestQuestion {
  id             String       @id @default(cuid())
  test           AttitudeTest @relation(fields: [testId], references: [id])
  testId         String
  text           String
  options        String       // JSON-encoded string array
  correctIndex   Int
  order          Int          @default(0)
}

model AttitudeTestSubmission {
  id            String       @id @default(cuid())
  test          AttitudeTest @relation(fields: [testId], references: [id])
  testId        String
  application   Application  @relation(fields: [applicationId], references: [id])
  applicationId String       @unique
  answers       String       // JSON-encoded array of chosen option indices
  score         Int
  total         Int
  submittedAt   DateTime     @default(now())
}

model User {
  id             String    @id @default(cuid())
  school         School?   @relation(fields: [schoolId], references: [id])
  schoolId       String?   // null for individual (non-school) students
  role           String    // STUDENT | LECTURER | STAFF (non-academic) | ADMIN
  fullName       String
  email          String    @unique
  passwordHash   String
  phone          String?
  matricNumber   String?   // students
  staffId        String?   // lecturers / staff / admin
  staffType      String?   // ACADEMIC | NON_ACADEMIC -- meaningful when role is LECTURER/STAFF
  position       String?   // job title for non-academic staff, e.g. "Librarian"
  accessCode     String?   @unique // school-issued login code for STUDENT/LECTURER/STAFF (alongside email+password)
  isIndividual   Boolean   @default(false) // true = self-registered learner, not affiliated with any school
  attendedSchoolName String? // individual learners only: their real institution (not a Learnza School row)
  attendedDepartment String? // individual learners only
  courseOfStudy      String? // individual learners only: their real degree programme
  status         String    @default("ACTIVE") // ACTIVE | SUSPENDED | DISMISSED (lecturer) | EXPELLED (student)
  department     Department? @relation(fields: [departmentId], references: [id])
  departmentId   String?
  yearOfStudy    Int?      // school students only, e.g. 1, 2, 3 -- set by admin at registration
  createdAt      DateTime  @default(now())

  enrollments    Enrollment[]
  lessonsCreated Lesson[]        @relation("LessonAuthor")
  libraryUploads LibraryResource[] @relation("LibraryUploader")
  groupsCreated  StudyGroup[]    @relation("GroupCreator")
  memberships    GroupMembership[]
  messages       GroupMessage[]
  assessmentsMade Assessment[]   @relation("AssessmentAuthor")
  submissions    Submission[]
  activityLogs   ActivityLog[]
  subscription   Subscription?
  payments       Payment[]
  aiTeacherSessions AiTeacherSession[]
  liveClassesHosted LiveClass[]  @relation("LiveClassHost")
  stats          UserStats?
  badges         UserBadge[]
  labDemonstrationsMade LabDemonstration[] @relation("LabDemoAuthor")
  applicationRegistered Application? @relation("ApplicationRegisteredUser")
  attendanceRecords StaffAttendanceRecord[]
  cpdRecords     CpdRecord[]
  publications   Publication[]
  transcriptRequests TranscriptRequest[]
  clearanceRequests  ClearanceRequest[]
  credentials    Credential[]
  hostelApplications HostelApplication[]
  individualCourses IndividualCourse[]
  classAttendance ClassAttendanceRecord[] @relation("ClassAttendanceStudent")
  classAttendanceMarked ClassAttendanceRecord[] @relation("ClassAttendanceMarker")
  assignmentsMade Assignment[] @relation("AssignmentAuthor")
  assignmentSubmissions AssignmentSubmission[]
  resultsMade    Result[]     @relation("ResultAuthor")
  resultsReceived Result[]    @relation("ResultStudent")
  notifications  Notification[]
}

// Lightweight gamification: points + a daily streak, no leaderboard/ranking by design
// (per the original spec -- study groups and personal progress stay private).
model UserStats {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String   @unique
  points           Int      @default(0)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate DateTime?
  updatedAt        DateTime @updatedAt
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique // FIRST_EXAM | STREAK_7 | STREAK_30 | SHARPSHOOTER
  name        String
  description String
  icon        String
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  badgeId  String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Subscription {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String    @unique
  plan          String    // MONTHLY | YEARLY
  status        String    // PENDING | ACTIVE | EXPIRED | CANCELLED
  startedAt     DateTime?
  expiresAt     DateTime?
  aiSecondsGranted Int    @default(0) // live AI Teacher (avatar/voice) time granted this billing cycle
  aiSecondsUsed    Int    @default(0) // cumulative seconds of AI-generated speech played back so far
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id])
  userId         String
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  provider       String        // PAYSTACK | FLUTTERWAVE
  reference      String        @unique
  plan           String        // MONTHLY | YEARLY
  amountKobo     Int
  status         String        // PENDING | SUCCESS | FAILED
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Department {
  id           String        @id @default(cuid())
  school       School        @relation(fields: [schoolId], references: [id])
  schoolId     String
  name         String
  code         String
  courses      Course[]
  users        User[]
  applications Application[]

  @@unique([schoolId, code])
}

model Course {
  id           String       @id @default(cuid())
  department   Department   @relation(fields: [departmentId], references: [id])
  departmentId String
  code         String
  title        String
  level        String       // e.g. NCE 1, NCE 2, 100L
  semester     String       // First / Second
  semesterRef   Semester?    @relation(fields: [semesterId], references: [id])
  semesterId    String?
  lessons      Lesson[]
  library      LibraryResource[]
  enrollments  Enrollment[]
  groups       StudyGroup[]
  assessments  Assessment[]
  aiTeacherSessions AiTeacherSession[]
  liveClasses  LiveClass[]
  labDemonstrations LabDemonstration[]
  classAttendance ClassAttendanceRecord[]
  assignments  Assignment[]
  results      Result[]

  @@unique([departmentId, code])
}

model Enrollment {
  id        String   @id @default(cuid())
  student   User     @relation(fields: [studentId], references: [id])
  studentId String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model Lesson {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String
  title       String
  order       Int      @default(0)
  script      String   // narration script read aloud by the AI teacher (text-to-speech, free)
  videoUrl    String?  // optional lecturer-recorded video link
  author      User?    @relation("LessonAuthor", fields: [authorId], references: [id])
  authorId    String?
  isAiTeacher Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model LibraryResource {
  id           String     @id @default(cuid())
  course       Course?    @relation(fields: [courseId], references: [id])
  courseId     String?
  title        String
  author       String
  publisher    String?
  type         String     // Textbook / Journal / Past Question / Handout
  fileUrl      String
  uploader     User?      @relation("LibraryUploader", fields: [uploaderId], references: [id])
  uploaderId   String?
  createdAt    DateTime   @default(now())
}

model StudyGroup {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String
  name        String
  creator     User     @relation("GroupCreator", fields: [creatorId], references: [id])
  creatorId   String
  createdAt   DateTime @default(now())
  members     GroupMembership[]
  messages    GroupMessage[]
}

model GroupMembership {
  id        String     @id @default(cuid())
  group     StudyGroup @relation(fields: [groupId], references: [id])
  groupId   String
  student   User       @relation(fields: [studentId], references: [id])
  studentId String
  joinedAt  DateTime   @default(now())

  @@unique([groupId, studentId])
}

model GroupMessage {
  id        String     @id @default(cuid())
  group     StudyGroup @relation(fields: [groupId], references: [id])
  groupId   String
  sender    User       @relation(fields: [senderId], references: [id])
  senderId  String
  body      String?    // null for a file-only message
  fileUrl   String?
  fileName  String?
  fileMime  String?
  createdAt DateTime   @default(now())
}

// courseId/individualCourseId are mutually exclusive, mirroring AiTeacherSession's
// course-vs-individualCourse split: a school-course assessment is lecturer-authored,
// an individual-course one is app-generated (self.authorId) for a self-directed
// learner's own IndividualCourse and has no lecturer marking step at all.
model Assessment {
  id          String       @id @default(cuid())
  course      Course?      @relation(fields: [courseId], references: [id])
  courseId    String?
  individualCourse IndividualCourse? @relation(fields: [individualCourseId], references: [id])
  individualCourseId String?
  title       String
  type        String       // CA / Mock / Exam / Assignment / PAST_QUESTION / SEMESTER_EXAM
  author      User         @relation("AssessmentAuthor", fields: [authorId], references: [id])
  authorId    String
  durationMin Int          @default(20)
  questions   Question[]
  submissions Submission[]
  semester    Semester?    @relation(fields: [semesterId], references: [id])
  semesterId  String?
  createdAt   DateTime     @default(now())
}

model Question {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  assessmentId String
  questionType String     @default("OBJECTIVE") // OBJECTIVE | THEORY
  text         String
  options      String?    // JSON-encoded string array, OBJECTIVE only
  correctIndex Int?       // OBJECTIVE only
  modelAnswer  String?    // THEORY only -- shown back to the student for self-review, never auto-graded
  order        Int        @default(0)
}

model Submission {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  assessmentId String
  student      User       @relation(fields: [studentId], references: [id])
  studentId    String
  startedAt    DateTime?  // server-stamped when the student opens a timed attempt, for deadline enforcement
  answers      String?    // JSON-encoded array of {questionId, choice|text} -- null until actually submitted
  score        Int?       // null until submitted (a started-but-not-submitted row has startedAt set, score null)
  total        Int?
  submittedAt  DateTime?

  @@unique([assessmentId, studentId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

// Interactive AI Teacher: an LLM-generated lesson plan (sections with narration +
// whiteboard text + an optional check question), walked through turn by turn, with
// student interrupts and a final AI-graded assessment. Requires an active subscription.
model AiTeacherSession {
  id          String            @id @default(cuid())
  student     User              @relation(fields: [studentId], references: [id])
  studentId   String
  course      Course?           @relation(fields: [courseId], references: [id])
  courseId    String?
  individualCourse IndividualCourse? @relation(fields: [individualCourseId], references: [id])
  individualCourseId String?
  topic       String
  planJson    String            // JSON-encoded lesson plan: { title, sections: [{title, boardText, speechText, checkQuestion}] }
  sectionIdx  Int               @default(0)
  status      String            @default("ACTIVE") // ACTIVE | COMPLETED
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  turns       AiTeacherTurn[]
}

model AiTeacherTurn {
  id           String           @id @default(cuid())
  session      AiTeacherSession @relation(fields: [sessionId], references: [id])
  sessionId    String
  role         String           // TEACHER | STUDENT
  type         String           // SECTION | INTERRUPT_QUESTION | INTERRUPT_ANSWER | CHECK_ANSWER | FEEDBACK
  content      String
  sectionIdx   Int?
  createdAt    DateTime         @default(now())
}

// A lecturer-hosted live video class. WebRTC signaling (offer/answer/ICE) happens over
// Socket.IO (src/realtime/live.js); this row just tracks whether one is currently on,
// so students can see a "Live now" banner without holding a socket connection open.
model LiveClass {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  host      User     @relation("LiveClassHost", fields: [hostId], references: [id])
  hostId    String
  title     String
  status    String   @default("ACTIVE") // ACTIVE | ENDED
  startedAt DateTime @default(now())
  endedAt   DateTime?
}

// Digital lab: a practical/demonstration walkthrough (steps with instructions and
// expected results). Lecturer-authored ones are trusted and go live immediately.
// Student-requested ones are AI-generated on demand and held back behind a human
// admin approval queue before any student can see them -- same safety pattern PassNow
// uses, since an unreviewed AI-written "practical" could describe an unsafe procedure.
model LabDemonstration {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String
  title       String
  description String
  stepsJson   String   // JSON-encoded [{title, instruction, expectedResult}]
  source      String   // CURATED | AI_GENERATED
  status      String   @default("APPROVED") // APPROVED | PENDING | REJECTED
  author      User?    @relation("LabDemoAuthor", fields: [authorId], references: [id])
  authorId    String?
  createdAt   DateTime @default(now())
}

// Admissions pipeline: application -> screening -> acceptance -> registration.
// Applying needs no account (a prospective student doesn't have one yet); registering
// creates the real User row and links back here via registeredUserId.
model Application {
  id             String     @id @default(cuid())
  school         School     @relation(fields: [schoolId], references: [id])
  schoolId       String
  department     Department @relation(fields: [departmentId], references: [id])
  departmentId   String
  fullName       String
  email          String
  phone          String
  level          String     // e.g. NCE 1
  statement      String?    // short "why this programme" note
  status         String     @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | ACCEPTED | REJECTED | REGISTERED
  registeredUser User?      @relation("ApplicationRegisteredUser", fields: [registeredUserId], references: [id])
  registeredUserId String?  @unique
  attitudeTestSubmission AttitudeTestSubmission?
  createdAt      DateTime   @default(now())
  decidedAt      DateTime?
}

// Staff records: attendance (lecturer self-check-in), CPD, and publications. Workload
// is deliberately NOT a stored model -- it's computed on demand from real activity
// (courses, lessons, assessments, live classes already in the DB) rather than a
// second, manually-entered number that could drift from reality.
model StaffAttendanceRecord {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime // truncated to midnight of the day marked
  status    String   @default("PRESENT") // PRESENT | LATE
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model CpdRecord {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  title       String
  provider    String
  hours       Int
  completedAt DateTime
  createdAt   DateTime @default(now())
}

model Publication {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  outlet    String
  year      Int
  url       String?
  createdAt DateTime @default(now())
}

// A student requests a transcript; admin "issues" it once ready. The transcript
// itself is just a formatted view of the student's real Submission history --
// nothing new to fabricate, just a gate on when it's presented as official.
model TranscriptRequest {
  id          String    @id @default(cuid())
  student     User      @relation(fields: [studentId], references: [id])
  studentId   String
  status      String    @default("PENDING") // PENDING | ISSUED
  requestedAt DateTime  @default(now())
  issuedAt    DateTime?
}

model ClearanceRequest {
  id          String    @id @default(cuid())
  student     User      @relation(fields: [studentId], references: [id])
  studentId   String
  status      String    @default("PENDING") // PENDING | CLEARED | DENIED
  note        String?
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
}

// A digital credential (e.g. a graduation certificate) with a public verification
// code -- matches how a real institution lets anyone verify a certificate is genuine
// without needing an account.
model Credential {
  id         String   @id @default(cuid())
  student    User     @relation(fields: [studentId], references: [id])
  studentId  String
  title      String
  verifyCode String   @unique
  issuedAt   DateTime @default(now())
}

model HostelApplication {
  id             String    @id @default(cuid())
  student        User      @relation(fields: [studentId], references: [id])
  studentId      String
  roomPreference String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  hostel         Hostel?   @relation(fields: [hostelId], references: [id])
  hostelId       String?
  roomAssigned   String?
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
}

// A self-directed course an individual (non-school) learner creates for themselves --
// the AI Teacher teaches it, but there is no lecturer, no department, no enrollment
// catalog. Individual learners never see school/lecturer features at all.
model IndividualCourse {
  id          String   @id @default(cuid())
  student     User     @relation(fields: [studentId], references: [id])
  studentId   String
  title       String
  description String?
  createdAt   DateTime @default(now())
  aiTeacherSessions AiTeacherSession[]
  assessments Assessment[]
}

// Per-class daily attendance, marked by the lecturer teaching that course (distinct
// from StaffAttendanceRecord, which is the lecturer's own self-check-in).
model ClassAttendanceRecord {
  id         String   @id @default(cuid())
  course     Course   @relation(fields: [courseId], references: [id])
  courseId   String
  student    User     @relation("ClassAttendanceStudent", fields: [studentId], references: [id])
  studentId  String
  date       DateTime // truncated to midnight of the day marked
  status     String   // PRESENT | ABSENT
  markedBy   User     @relation("ClassAttendanceMarker", fields: [markedById], references: [id])
  markedById String
  semester   Semester? @relation(fields: [semesterId], references: [id])
  semesterId String?
  createdAt  DateTime @default(now())

  @@unique([courseId, studentId, date])
}

// Free-response assignment: lecturer posts it, student answers in text, lecturer
// marks it and the score/feedback goes back to the student -- distinct from the
// auto-graded multiple-choice Assessment/CBT flow.
model Assignment {
  id           String   @id @default(cuid())
  course       Course   @relation(fields: [courseId], references: [id])
  courseId     String
  title        String
  instructions String
  dueAt        DateTime?
  author       User     @relation("AssignmentAuthor", fields: [authorId], references: [id])
  authorId     String
  kind         String   @default("ASSIGNMENT") // ASSIGNMENT | PROJECT
  semester     Semester? @relation(fields: [semesterId], references: [id])
  semesterId   String?
  createdAt    DateTime @default(now())
  submissions  AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String
  student      User       @relation(fields: [studentId], references: [id])
  studentId    String
  answerText   String
  submittedAt  DateTime   @default(now())
  status       String     @default("SUBMITTED") // SUBMITTED | MARKED
  score        Int?
  feedback     String?
  markedAt     DateTime?

  @@unique([assignmentId, studentId])
}

// A lecturer-compiled formal result (distinct from raw CBT/assignment scores) --
// published to a student for one course/term, visible to the student and to school
// admin. This is the "send results to students" feature, not the CBT auto-grading.
model Result {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id])
  courseId    String
  student     User     @relation("ResultStudent", fields: [studentId], references: [id])
  studentId   String
  author      User     @relation("ResultAuthor", fields: [authorId], references: [id])
  authorId    String
  term        String   // e.g. "First Semester 2026"
  semester    Semester? @relation(fields: [semesterId], references: [id])
  semesterId  String?
  score       Int
  grade       String?
  remark      String?
  publishedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  body      String
  link      String?  // a frontend screen name to navigate to on click
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
